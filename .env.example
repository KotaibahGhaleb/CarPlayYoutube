# Copy to .env.local for Next.js. Do not commit real values.
# None of these are NEXT_PUBLIC_ — they must stay on the server.

# Required before this app is reachable by anyone but you.
# Library routes refuse public requests until this is set.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
LIBRARY_GATE_KEY=

# Python library service. Defaults to http://127.0.0.1:8787
YTMUSIC_SERVICE_URL=http://127.0.0.1:8787

# Shared by Next.js and the Python service. Leave empty only when the
# Python process is bound to localhost and nothing else can reach it.
YTMUSIC_SERVICE_KEY=

# --- Python service (shell environment, not the Next.js bundle) ---
# YTMUSIC_BIND=127.0.0.1
# YTMUSIC_PORT=8787
# YTMUSIC_AUTH_PATH=.secrets/ytmusic-auth.json
#
# TV / limited-input OAuth client from Google Cloud. Not a website client.
# YouTube Data API must be enabled on that project.
# YTMUSIC_CLIENT_ID=
# YTMUSIC_CLIENT_SECRET=
